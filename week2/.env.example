# Copy to week2/.env (gitignored) and fill in from Google Cloud Console
# -> APIs & Services -> Credentials -> OAuth client ID (type: Desktop app)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: where the OAuth token is cached (default: ~/.gmail-mcp/token.json, outside the repo)
# GMAIL_MCP_TOKEN_PATH=
